{
  "name": "message-automation",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "pnpm --filter @message-automation/api start:dev",
    "dev:web": "pnpm --filter @message-automation/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"{apps,packages}/*/{src,test}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{apps,packages}/*/{src,test}/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2"
  }
}
