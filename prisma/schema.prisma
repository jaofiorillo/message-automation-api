// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FlowStatus {
  draft
  live
}

enum Channel {
  instagram
  facebook
  whatsapp
  telegram
}

// An automation. `ns` is the public identifier (ManyChat format:
// content<YYYYMMDDHHmmss>_<6 digits>).
model Flow {
  id            Int           @id @default(autoincrement())
  ns            String        @unique
  name          String
  path          String        @default("/")
  status        FlowStatus    @default(draft)
  // Unpublished editor state: { rootContent, contents[], coordinates }. Null
  // means the published version is current.
  draft         Json?
  coordinates   Json?
  rootContentId Int?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contents      FlowContent[]
  keywordRules  KeywordRule[]

  @@index([path])
}

// A published node of a flow. `id` is the server-assigned content_id; it stays
// stable across republishes because contents are matched by `oid`.
model FlowContent {
  id        Int      @id @default(autoincrement())
  flowId    Int
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  oid       String
  type      String
  caption   String
  data      Json
  targetOid String?
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flowId, oid])
}

// A keyword trigger. It lives outside the flow graph and points to a flow.
model KeywordRule {
  id           Int      @id @default(autoincrement())
  flowId       Int
  flow         Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  name         String
  channel      Channel
  sort         Int      @default(0)
  // [{ condition: "is" | "contains" | "starts_with", keywords: string[] }]
  keywordRules Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([channel])
}
